<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile : catégories en puces horizontales au-dessus de la liste -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:textSize="26sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad">

        <include layout="@layout/view_search" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cats"
        android:tag="chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none" />

    <include layout="@layout/view_list_area" />
</LinearLayout>
