<?xml version="1.0" encoding="utf-8"?>
<!-- Téléchargements : films et épisodes enregistrés sur l'appareil -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="@dimen/page_pad">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include layout="@layout/view_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Téléchargements"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/dl_settings"
            style="@style/Btn"
            android:text="Réglages" />
    </LinearLayout>

    <TextView
        android:id="@+id/dl_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dl_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="Aucun téléchargement.\nSur la fiche d'un film, ou par un appui long sur un épisode, choisis « Télécharger »."
        android:textColor="@color/muted"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dl_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
