<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile : tuiles en grille 2 × 2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/page_pad">

    <include layout="@layout/view_brand" />

    <include layout="@layout/view_update" />

    <include layout="@layout/view_resume" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_live"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1">

                <com.koala.tv.TileImage style="@style/TileIcon" android:src="@drawable/ic_tile_live" />
                <TextView style="@style/TileLabel" android:text="TV en direct" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_movies"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1">

                <com.koala.tv.TileImage style="@style/TileIcon" android:src="@drawable/ic_tile_movies" />
                <TextView style="@style/TileLabel" android:text="Films" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tile_series"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <com.koala.tv.TileImage style="@style/TileIcon" android:src="@drawable/ic_tile_series" />
                <TextView style="@style/TileLabel" android:text="Séries" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tile_settings"
                style="@style/Tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1">

                <com.koala.tv.TileImage style="@style/TileIcon" android:src="@drawable/ic_tile_settings" />
                <TextView style="@style/TileLabel" android:text="Réglages" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
