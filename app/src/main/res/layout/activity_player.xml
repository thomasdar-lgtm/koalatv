<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:keepScreenOn="true"
        app:buffered_color="#66FFFFFF"
        app:played_color="@color/accent"
        app:resize_mode="fit"
        app:scrubber_color="@color/accent"
        app:show_buffering="always"
        app:show_subtitle_button="true"
        app:unplayed_color="#33FFFFFF"
        app:use_controller="true" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/info_gradient"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="64dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <include
                layout="@layout/view_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/ov_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/ov_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/btn_bg"
                android:clickable="true"
                android:contentDescription="Image dans l'image"
                android:focusable="false"
                android:padding="10dp"
                android:src="@drawable/ic_pip"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/ov_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_soft"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:background="@drawable/status_bg"
        android:fontFamily="@font/inter_bold"
        android:minWidth="96dp"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:textColor="@color/accent"
        android:textSize="40sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:background="@drawable/status_bg"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
